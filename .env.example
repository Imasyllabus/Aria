# Copy to .env and fill in. The CLI auto-loads .env if python-dotenv is installed.
# NEVER commit the real .env (it is git-ignored).

# --- Which mailboxes to read ("gmail", "outlook", or "gmail,outlook") ---
ARIA_PROVIDERS=gmail,outlook

# How many recent messages to pull per mailbox
ARIA_MAX_RESULTS=50

# Rule confidence below this threshold escalates an email to the AI classifier
ARIA_CONFIDENCE_THRESHOLD=0.6

# Comma-separated VIP senders (emails or domains) that are always top priority
ARIA_VIP_SENDERS=boss@company.com,important-client.com

# --- Background service (`aria watch`) ---
# Seconds between auto-sort cycles
ARIA_WATCH_INTERVAL=300
# Tracks already-processed messages so restarts don't re-classify/re-bill them
ARIA_STATE_FILE=aria_state.json

# --- Gmail (Google Cloud OAuth desktop client) ---
# Download an OAuth client (Desktop app) from Google Cloud Console -> APIs & Services -> Credentials.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=gmail_token.json
# "modify" = read/label/trash (recommended). "full" = also allows permanent delete (--purge).
GMAIL_SCOPE=modify

# --- Outlook / Microsoft 365 (Azure app registration, public client) ---
OUTLOOK_CLIENT_ID=
# "common" works for personal + work accounts; or your tenant id
OUTLOOK_TENANT_ID=common
OUTLOOK_TOKEN_CACHE=outlook_token_cache.json

# --- Claude AI classifier (only needed when --ai is used) ---
ANTHROPIC_API_KEY=
# Default is the most capable model. For a cheaper high-volume run, set claude-haiku-4-5.
ARIA_AI_MODEL=claude-opus-4-7
# Reasoning effort for the classifier (opus/sonnet-4.6 only; ignored on haiku): low|medium|high
ARIA_AI_EFFORT=low
# Emails per AI request (batched to amortize cost)
ARIA_AI_BATCH_SIZE=20
